{
  "name": "easecutpro",
  "version": "0.1.0",
  "description": "EaseCutPro - offline, native Windows transcript-based video editor (Descript-like)",
  "main": "./out/main/index.js",
  "author": "EaseCutPro",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "server": "tsx src/server/index.ts",
    "server:dev": "tsx watch src/server/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "setup-parakeet": "node scripts/setup-parakeet.mjs",
    "verify-retake-aware": "tsx scripts/verify-retakeaware.ts",
    "verify-retake-aware-fixtures": "tsx scripts/verify-retake-fixtures.ts",
    "verify-silence-presets": "tsx --tsconfig tsconfig.web.json scripts/verify-silence-presets.ts",
    "web": "electron-vite build && tsx src/server/index.ts",
    "prepare:cloud": "node scripts/prepare-cloud-assets.mjs",
    "dev:cloud": "npm run prepare:cloud && vite --config vite.config.cloud.ts",
    "build:cloud": "npm run prepare:cloud && vite build --config vite.config.cloud.ts",
    "remote": "node scripts/remote.mjs",
    "remote:named": "node scripts/remote.mjs lt",
    "selfhost": "node scripts/selfhost.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "package": "electron-vite build && electron-packager . EaseCutPro --platform=win32 --arch=x64 --out=release --overwrite --prune=true --icon=icons/icon.ico --extra-resource=resources/bin --extra-resource=resources/models --ignore=\"^/(src|release|resources|\\.fr|\\.frames|.*\\.log)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediabunny/aac-encoder": "^1.50.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@supabase/supabase-js": "^2.110.2",
    "express": "^4.19.2",
    "mediabunny": "^1.50.8",
    "mp4-muxer": "^5.2.2",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-web": "^1.27.0",
    "openai": "^6.45.0",
    "sherpa-onnx-node": "^1.13.3",
    "ws": "^8.18.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@electron/packager": "^20.0.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "localtunnel": "^2.0.2",
    "png-to-ico": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.easecutpro.app",
    "productName": "EaseCutPro",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ]
    }
  }
}
