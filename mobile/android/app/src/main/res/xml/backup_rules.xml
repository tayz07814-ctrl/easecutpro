<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Same reasoning as data_extraction_rules.xml:
     session tokens and transcripts must never leave the device in a backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
