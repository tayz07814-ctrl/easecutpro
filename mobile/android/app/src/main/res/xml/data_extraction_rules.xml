<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (cloud backup and device-to-device transfer).

  Nothing this app stores is safe to copy off the device: shared_preferences
  holds the Supabase session (access + refresh token in cleartext), and the
  project files hold the user's transcripts — i.e. everything they said on
  camera. Excluding both means a backup image can never be mined for a live
  session token or private speech.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
