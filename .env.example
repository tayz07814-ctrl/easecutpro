# Cloud build (Vercel + Supabase) — copy to .env for local `npm run dev:cloud`,
# and set the same two vars in the Vercel project settings for deploys.
# Values come from your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Easecut premium redesign. The CLOUD build (Vercel) now defaults this ON, so
# production ships the redesigned UI. Set to `false` here (or in the Vercel
# project settings, then redeploy) to fall back to the legacy UI. The Electron /
# self-host builds stay on the legacy UI unless this is explicitly `true`.
# Purely presentational; no engine behavior changes.
# VITE_NEW_EASECUT_UI=false
