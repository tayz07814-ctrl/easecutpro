# Cloud build (Vercel + Supabase) — copy to .env for local `npm run dev:cloud`,
# and set the same two vars in the Vercel project settings for deploys.
# Values come from your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Easecut premium redesign (opt-in). Unset/false = the existing UI ships
# unchanged. Set to `true` (here for local dev, or in Vercel project settings)
# to enable the redesigned UI. Purely presentational; no engine behavior changes.
VITE_NEW_EASECUT_UI=false

# ---- Paddle (Pro subscriptions; cloud build) — see PAYMENTS.md ----
# These are PUBLIC (they ship in the frontend). The webhook signing secret is
# NOT here — it's a Supabase function secret: `supabase secrets set PADDLE_WEBHOOK_SECRET=…`.
# Client-side token: Paddle -> Developer Tools -> Authentication.
VITE_PADDLE_CLIENT_TOKEN=
# 'sandbox' while testing, 'production' when live.
VITE_PADDLE_ENV=sandbox
# Price IDs: Paddle -> Catalog -> Products. At least one is required to show the
# Upgrade button (annual is optional).
VITE_PADDLE_PRICE_MONTHLY=
VITE_PADDLE_PRICE_ANNUAL=
